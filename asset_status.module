<?php

declare(strict_types=1);

use Drupal\Core\Cache\Cache;
use Drupal\Core\Entity\Display\EntityViewDisplayInterface;
use Drupal\Core\Entity\Entity\EntityViewDisplay;
use Drupal\Core\Entity\EntityInterface;
use Drupal\views\Plugin\views\query\QueryPluginBase;
use Drupal\views\Plugin\views\query\Sql;
use Drupal\views\ViewExecutable;
use Drupal\Core\Form\FormStateInterface;
use Drupal\node\NodeInterface;
use Drupal\Core\Field\FieldDefinitionInterface;
use Drupal\Core\Session\AccountInterface;
use Drupal\Core\Access\AccessResult;
use Drupal\Core\Field\FieldItemListInterface;

/**
 * Implements hook_form_BASE_FORM_ID_alter() for node forms.
 */
function asset_status_form_node_form_alter(array &$form, FormStateInterface $form_state, string $form_id): void {
  /** @var \Drupal\node\NodeInterface $node */
  $node = $form_state->getFormObject()->getEntity();

  // Only apply to 'item' content type.
  if ($node->bundle() !== 'item') {
    return;
  }

  $account = \Drupal::currentUser();
  $is_full_admin = $account->hasPermission('administer asset log entries');

  // For existing items: redirect non-admins away from the bare status field.
  // Full admins keep the field (they may need it for initial setup / bulk edits)
  // but still get the log message textarea.
  if (!$node->isNew() && !$is_full_admin) {
    // Hide the raw status field — changing it here skips the logging workflow.
    if (isset($form['field_item_status'])) {
      $form['field_item_status']['#access'] = FALSE;
    }

    // Show a prominent button linking to the dedicated Quick Status form,
    // which enforces logging in a single step.
    $quick_status_url = \Drupal\Core\Url::fromRoute('asset_status.quick_status_update', [
      'node' => $node->id(),
    ])->toString();

    $form['asset_status_quick_link'] = [
      '#type' => 'markup',
      '#markup' => '<div class="asset-status-node-form-notice">'
        . '<strong>' . t('Need to change this tool\'s status?') . '</strong> '
        . t('Use the <a href="@url" class="button button--primary">Update Status &amp; Log</a> form — it records the reason and notifies staff in one step.', ['@url' => $quick_status_url])
        . '</div>',
      '#weight' => -5,
      '#attached' => ['library' => ['asset_status/node_form']],
    ];
  }
  else {
    // On create (or for full admins on edit): keep the status field and add
    // the log message textarea beneath it.
    $form['asset_status_log_message'] = [
      '#type' => 'textarea',
      '#title' => t('Status Change / Log Notes'),
      '#description' => t('Describe the reason for this status (e.g., "Belt snapped," "Routine cleaning"). Saved to the asset log and posted to Slack.'),
      '#rows' => 3,
      '#weight' => 1,
    ];

    $form['actions']['submit']['#submit'][] = 'asset_status_node_form_submit';
  }
}

/**
 * Custom submit handler to attach log message to the node entity.
 */
function asset_status_node_form_submit(array $form, FormStateInterface $form_state): void {
  $node = $form_state->getFormObject()->getEntity();
  $message = $form_state->getValue('asset_status_log_message');
  
  if (!empty($message)) {
    // Attach the message to the entity as a temporary property.
    // This allows hook_entity_update and the Slack module to access it.
    $node->_asset_status_log_message = $message;
  }
}

/**
 * Implements hook_entity_field_access().
 */
function asset_status_entity_field_access($operation, FieldDefinitionInterface $field_definition, AccountInterface $account, ?FieldItemListInterface $items = NULL) {
  // Hide 'reported_status' from the user on forms.
  // It is maintained internally or via specific member-facing forms.
  if ($field_definition->getName() === 'reported_status' && $operation === 'edit') {
    return AccessResult::forbidden();
  }
  return AccessResult::neutral();
}

/**
 * Logs node status changes through the Asset Status service layer.
 */
function asset_status_entity_insert(EntityInterface $entity): void {
  asset_status_handle_node_status_change($entity, TRUE);
}

/**
 * Reacts to updates on item nodes and records status history.
 */
function asset_status_entity_update(EntityInterface $entity): void {
  asset_status_handle_node_status_change($entity, FALSE);
}

/**
 * Delegates node status changes to the status change logger service.
 */
function asset_status_handle_node_status_change(EntityInterface $entity, bool $is_new): void {
  if (!$entity instanceof NodeInterface) {
    return;
  }

  // Allow other services (like manual maintenance logging) to skip automatic status logging
  // if they are already creating a more specific log entry.
  if (!empty($entity->_skip_asset_status_log)) {
    return;
  }

  if ($entity->bundle() !== 'item' || !$entity->hasField('field_item_status')) {
    return;
  }

  // The set (parent → units) or a unit's status may just have changed.
  \Drupal::service('asset_status.units')->resetCache();

  $current_term = !$entity->get('field_item_status')->isEmpty()
    ? $entity->get('field_item_status')->entity
    : NULL;

  $original_term = NULL;
  if (!$is_new && isset($entity->original) && $entity->original instanceof NodeInterface) {
    $original_field = $entity->original->get('field_item_status');
    if ($original_field && !$original_field->isEmpty()) {
      $original_term = $original_field->entity;
    }
  }

  $context = [
    'is_new' => $is_new,
  ];

  // Check for the custom log message attached by our submit handler.
  if (isset($entity->_asset_status_log_message)) {
    $context['details'] = $entity->_asset_status_log_message;
  }

  \Drupal::service('asset_status.status_change_logger')
    ->handleNodeStatusChange($entity, $original_term, $current_term, $context);

  // A unit retiring (or coming back) can change what its tool is.
  if ($original_term?->id() !== $current_term?->id()) {
    \Drupal::service('asset_status.units')->syncParentStatus($entity);
  }
}

/**
 * Implements hook_node_view().
 *
 * A unit page (one machine of a multi-unit tool) is thin by design: its own
 * fields hold only what is per machine. So that a label on the machine can
 * point straight at the unit, the full page borrows the parent tool's
 * documentation — description, badge, instructions, manuals, videos — for
 * every field the unit leaves empty, and says which tool it is part of.
 */
function asset_status_node_view(array &$build, EntityInterface $node, EntityViewDisplayInterface $display, string $view_mode): void {
  if (!$node instanceof NodeInterface || $node->bundle() !== 'item' || $view_mode !== 'full') {
    return;
  }
  /** @var \Drupal\asset_status\Service\UnitManager $units */
  $units = \Drupal::service('asset_status.units');
  if (!$units->isUnit($node)) {
    return;
  }
  $parent = $units->getParent($node);
  if (!$parent || !$parent->access('view')) {
    return;
  }

  $build['asset_status_parent'] = [
    '#type' => 'container',
    '#attributes' => ['class' => ['asset-unit-parent']],
    '#weight' => -100,
    'text' => [
      '#markup' => t('One of the machines of <a href=":url">@tool</a>. Instructions and badge requirements below are the tool\'s.', [
        ':url' => $parent->toUrl()->toString(),
        '@tool' => $parent->label(),
      ]),
    ],
  ];

  $borrowed = [
    'field_item_image',
    'body',
    'field_member_badges',
    'field_additional_badges',
    'field_item_instructions',
    'field_manuals',
    'field_item_member_only_informati',
    'field_item_requirements',
    'field_item_instructional_video',
    'field_item_videos',
    'field_item_hazard_band',
    'field_item_slack_channel',
    'field_item_location',
  ];
  $parent_display = EntityViewDisplay::collectRenderDisplay($parent, 'full');
  foreach ($borrowed as $field) {
    if (!$parent->hasField($field) || $parent->get($field)->isEmpty()) {
      continue;
    }
    if ($node->hasField($field) && !$node->get($field)->isEmpty()) {
      continue;
    }
    $component = $parent_display->getComponent($field);
    if (!$component) {
      continue;
    }
    if (!$parent->get($field)->access('view')) {
      continue;
    }
    $build[$field] = $parent->get($field)->view($component);
    $build[$field]['#weight'] = $component['weight'] ?? 0;
  }

  $build['#cache']['tags'] = Cache::mergeTags($build['#cache']['tags'] ?? [], $parent->getCacheTags());
}

/**
 * Implements hook_views_query_alter().
 *
 * Unit nodes are machines, not tools: the equipment list must show the tool
 * once, not once per machine. Any other item listing that should behave the
 * same way can be added to the list below.
 */
function asset_status_views_query_alter(ViewExecutable $view, QueryPluginBase $query): void {
  static $views = ['equipment' => TRUE, 'asset_status' => TRUE];
  if (!isset($views[$view->id()]) || !$query instanceof Sql) {
    return;
  }
  $tid = \Drupal::service('asset_status.units')->unitTermId();
  if ($tid === NULL) {
    return;
  }
  $base = $view->storage->get('base_table') === 'node_field_data' ? 'node_field_data' : NULL;
  if (!$base) {
    return;
  }
  $query->addWhereExpression(0,
    "$base.nid NOT IN (SELECT c.entity_id FROM {node__field_item_category} c WHERE c.field_item_category_target_id = :asset_status_unit_tid AND c.deleted = 0)",
    [':asset_status_unit_tid' => $tid]
  );
}

/**
 * Implements hook_preprocess_form_element().
 *
 * Activates Bootstrap Barrio's built-in 'form-button' checkbox style for the
 * individual radio buttons inside the confirmed-status widget. This switches
 * the template from form-check-input/form-check-label (which fight our CSS)
 * to btn-check/btn btn-outline-primary (Bootstrap's own styled-radio pattern).
 * The module's maintenance_form.css then overrides the colors per status.
 */
function asset_status_preprocess_form_element(array &$variables): void {
  $element = $variables['element'];
  if (
    isset($element['#type']) &&
    $element['#type'] === 'radio' &&
    !empty($element['#wrapper_attributes']['class']) &&
    in_array('status-radio-item', (array) $element['#wrapper_attributes']['class'])
  ) {
    $variables['checkbox_style'] = 'form-button';
  }
}

/**
 * Implements hook_theme().
 */
function asset_status_theme(): array {
  return [
    'asset_status_block' => [
      'variables' => [
        'since' => NULL,
        'expected_back' => NULL,
        'overdue' => FALSE,
        'status_label' => NULL,
        'status_class' => NULL,
        'message' => NULL,
        'history_url' => NULL,
        'staff_action_url' => NULL,
        'parent' => NULL,
        'units' => NULL,
      ],
    ],
  ];
}

/**
 * Implements hook_cron().
 *
 * Once a day, nudge staff about tools stuck in a non-operational status. The
 * monitor gates itself to one run per ~20 hours, so hourly cron is fine.
 */
function asset_status_cron(): void {
  \Drupal::service('asset_status.stale_monitor')->runFromCron();
}
